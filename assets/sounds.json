{
  "$comment": "音效行为表（纯配置，不含音频）。行为 = 触发 × 播放 × 条件；id 稳定不可随意改（用户配置用 pack.id 引用它）。音频文件按 sound 字段找 web/sounds/<sound>.wav，缺失则该行为静默。",
  "version": 1,
  "packs": [
    {
      "id": "meow",
      "label": "圆宝叫声",
      "behaviors": [
        {
          "id": "meow",
          "label": "叫一声",
          "on": { "event": "press" },
          "sound": "meow_press",
          "play": { "mode": "once" }
        },
        {
          "id": "purr",
          "label": "长按呼噜",
          "on": { "event": "press", "delayMs": 600 },
          "sound": "purr_loop",
          "play": { "mode": "loop", "until": "release", "fadeOutMs": 150 },
          "volume": 0.8,
          "instances": 2
        }
      ]
    },
    {
      "id": "duck",
      "label": "鸭子叫声",
      "behaviors": [
        {
          "id": "press",
          "label": "按下声音",
          "on": { "event": "press" },
          "sound": "duck_press",
          "play": { "mode": "once" }
        },
        {
          "id": "release",
          "label": "松手声音",
          "on": { "event": "release" },
          "sound": "duck_release",
          "play": { "mode": "once" }
        }
      ]
    }
  ]
}
